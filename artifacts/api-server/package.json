{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "cleanup:contact-placeholders": "node --experimental-strip-types ./scripts/cleanup-deleted-contact-placeholders.ts",
    "provision-roip": "node --experimental-strip-types ./scripts/provision-roip-sip.ts",
    "test:stripe-document-retry": "RUN_STRIPE_DOCUMENT_RETRY_TEST=1 tsx ./scripts/test-stripe-native-invoice.ts",
    "test:stripe-document-audit-concurrency": "test -n \"$DATABASE_URL\" || { echo \"Stripe document audit concurrency test requires DATABASE_URL; configure the validation database before running this command\" >&2; exit 1; }; RUN_STRIPE_DOCUMENT_AUDIT_CONCURRENCY_TEST=1 tsx ./scripts/test-stripe-native-invoice.ts",
    "test:stripe-document-audit-ordering": "RUN_STRIPE_DOCUMENT_AUDIT_ORDERING_TEST=1 tsx ./scripts/test-stripe-native-invoice.ts",
    "test:stripe-sandbox": "RUN_STRIPE_SANDBOX_TEST=1 tsx ./scripts/test-stripe-native-invoice.ts",
    "test:catalog-stripe-sandbox": "RUN_CATALOG_STRIPE_SANDBOX_TEST=1 tsx ./scripts/test-catalog-stripe-sandbox.ts",
    "test:clerk-invite": "NODE_ENV=development RUN_CLERK_INVITE_E2E=1 tsx ./scripts/run-isolated-staff-tests.ts clerk-invite",
    "test:staff-profile": "NODE_ENV=development tsx ./scripts/run-isolated-staff-tests.ts staff-profile",
    "test": "node --experimental-strip-types --test src/zoom-meetings.test.ts && node ./scripts/run-tests.mjs && pnpm run test:ptt-browser",
    "test:ptt-relay": "node ./scripts/test-ptt-turn-relay.mjs",
    "test:ptt-browser": "node ./scripts/run-ptt-browser-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@clerk/express": "^2.1.66",
    "@clerk/shared": "^4.31.0",
    "@google/genai": "^2.21.0",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^1.1.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@sendgrid/mail": "^8.1.6",
    "@slack/web-api": "^8.1.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "googleapis": "^178.0.0",
    "http-proxy-middleware": "^4.2.0",
    "imapflow": "^2.0.0",
    "mailparser": "^3.9.23",
    "memoizee": "^0.4.17",
    "nodemailer": "^10.0.9",
    "openai": "^7.10.0",
    "otplib": "^13.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "stripe": "^22.6.1",
    "stripe-replit-sync": "^1.0.0",
    "twilio": "^6.1.0",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zod": "catalog:",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/memoizee": "^0.4.12",
    "@types/node": "catalog:",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
